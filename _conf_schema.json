{
    "parsers_template": {
        "description": "扩展解析器",
        "type": "template_list",
        "hint": "配置要追加或覆盖的解析器。没配置或未启用的解析器将不会被注入到原插件中。",
        "templates": {
            "telegram": {
                "name": "Telegram 解析器",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "hint": "若需使用代理，需确保原插件或本地配置了可用代理",
                        "type": "bool",
                        "default": false
                    },
                    "api_id": {
                        "description": "api_id",
                        "hint": "可在 my.telegram.org 申请",
                        "type": "number",
                        "default": 2040
                    },
                    "api_hash": {
                        "description": "api_hash",
                        "hint": "可在 my.telegram.org 申请",
                        "type": "text",
                        "default": "b18441a1ff607e10a989891a5462e627"
                    }
                }
            },
            "magnet": {
                "name": "磁力解析器",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "type": "bool",
                        "default": false
                    },
                    "cookies": {
                        "description": "Cookies",
                        "hint": "选填",
                        "type": "text",
                        "default": ""
                    },
                    "image_send_mode": {
                        "description": "图片发送方式",
                        "hint": "磁力链接解析到的预览图片的发送方式",
                        "type": "string",
                        "options": [
                            "none",
                            "blur",
                            "original"
                        ],
                        "labels": [
                            "不发送",
                            "打码发送",
                            "原图发送"
                        ],
                        "default": "original"
                    }
                }
            },
            "jmcomic": {
                "name": "JMComic 解析器",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "type": "bool",
                        "default": false
                    },
                    "image_send_mode": {
                        "description": "漫画发送方式",
                        "type": "string",
                        "default": "pdf",
                        "options": [
                            "merge",
                            "pdf",
                            "ignore"
                        ],
                        "labels": [
                            "合并发送(极易风控，不推荐)",
                            "发送PDF",
                            "不发送"
                        ]
                    },
                    "nsfw": {
                        "description": "漫画封面处理方式",
                        "type": "string",
                        "options": [
                            "send",
                            "blur",
                            "ignore"
                        ],
                        "labels": [
                            "正常发送",
                            "模糊处理后发送",
                            "忽略"
                        ],
                        "default": "blur"
                    },
                    "max_page": {
                        "description": "最大页数",
                        "hint": "发送漫画时接受的最大页数，超过则跳过下载发送。0则不限制",
                        "type": "int",
                        "default": 50
                    }
                }
            },
            "ncm": {
                "name": "网易云音乐 (增强版)",
                "items": {
                    "enable": {
                        "description": "启用 (覆盖原插件基础版)",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "type": "bool",
                        "default": false
                    },
                    "cookies": {
                        "description": "Cookies",
                        "hint": "选填。登录后可自动填充，也可手动填写",
                        "type": "text",
                        "default": ""
                    },
                    "base_url": {
                        "description": "API 地址",
                        "hint": "必填。NodeJS 网易云音乐 API 的服务地址，如 http://localhost:3000",
                        "type": "string",
                        "default": "http://localhost:3000"
                    },
                    "quality": {
                        "description": "默认音质",
                        "hint": "下载歌曲的默认音质等级。若所选音质不可用会自动降级到最高可用音质",
                        "type": "string",
                        "options": [
                            "standard",
                            "higher",
                            "exhigh",
                            "lossless",
                            "hires",
                            "jyeffect",
                            "jymaster"
                        ],
                        "labels": [
                            "标准",
                            "较高",
                            "极高",
                            "无损",
                            "Hi-Res",
                            "高清环绕声",
                            "沉浸环绕声"
                        ],
                        "default": "exhigh"
                    }
                }
            },
            "xhs": {
                "name": "小红书 (增强版)",
                "items": {
                    "enable": {
                        "description": "启用 (覆盖原插件基础版)",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "type": "bool",
                        "default": false
                    },
                    "cookies": {
                        "description": "Cookies",
                        "hint": "选填, 小红书部分链接解析有水印, 填充Cookies可去除水印",
                        "type": "text",
                        "default": ""
                    },
                    "parse_original_image": {
                        "description": "解析原图(无水印)",
                        "hint": "开启后将获取无水印的原图，如果原图很大可能会拖慢解析速度",
                        "type": "bool",
                        "default": false
                    }
                }
            }
        }
    }
}